{
  "openapi": "3.1.0",
  "info": {
    "title": "ProvaPronta — Auth Service",
    "description": "Cadastro, login (JWT), papéis e redefinição de senha. Só a API do ProvaPronta fala com ele.",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "description": "Liveness: o processo está de pé e respondendo — nada além disso.",
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Liveness Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness",
        "description": "Readiness: o MySQL (tabela `usuarios`) é crítico — sem ele não há\nlogin nem cadastro, então 503. O log-service não: a auditoria do login\né fire-and-forget (atividade 5), o login funciona sem ela — só fica\n\"degraded\". Do log-service pergunta só se está vivo (/health/live),\nnunca o /health completo dele, pra não encadear falhas.",
        "operationId": "readiness_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Readiness Health Get"
                }
              }
            }
          },
          "503": {
            "description": "Dependência crítica fora (MySQL): não consigo atender"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "400": {
            "description": "E-mail já cadastrado",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Email já cadastrado"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "E-mail ou senha não batem com nenhum usuário cadastrado",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Email ou senha inválidos"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh",
        "description": "Token novo com o papel ATUAL do banco (atividade 7). O papel viaja\ndentro do JWT, então depois que um pagamento troca o papel, o token\nantigo continua dizendo o papel velho até expirar — o front chama\nisto logo que o pagamento é confirmado.",
        "operationId": "refresh_auth_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Credenciais inválidas ou expiradas"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioOut"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Credenciais inválidas ou expiradas"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/auth/users/{usuario_id}": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Usuario Publico",
        "description": "Nome de qualquer usuário, pra página de perfil (atividade 6) — o\ncatálogo é dono do perfil (bio, foto), mas o nome mora aqui, na tabela\n`usuarios`. Exige estar logado, mas não ser o dono: ver perfil alheio é\npermitido, editar é que não.",
        "operationId": "usuario_publico_auth_users__usuario_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "usuario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Usuario Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioPublicoOut"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Credenciais inválidas ou expiradas"
                }
              }
            }
          },
          "404": {
            "description": "usuario_id não existe",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Usuário não encontrado"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": [
          "password-reset"
        ],
        "summary": "Forgot Password",
        "operationId": "forgot_password_auth_forgot_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Forgot Password Auth Forgot Password Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": [
          "password-reset"
        ],
        "summary": "Reset Password",
        "operationId": "reset_password_auth_reset_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Reset Password Auth Reset Password Post"
                }
              }
            }
          },
          "400": {
            "description": "Token inexistente, expirado ou já usado",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Link inválido, expirado ou já utilizado"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/admin/users": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Listar Usuarios",
        "description": "Só admin: lista todos os usuários cadastrados — é o que permite a\nação exclusiva de admin desta atividade (promover/rebaixar o papel de\nalguém, olhando essa lista pra decidir quem).",
        "operationId": "listar_usuarios_auth_admin_users_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UsuarioOut"
                  },
                  "type": "array",
                  "title": "Response Listar Usuarios Auth Admin Users Get"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Credenciais inválidas ou expiradas"
                }
              }
            }
          },
          "403": {
            "description": "Autenticado, mas sem papel admin",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Acesso restrito a admins"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/auth/admin/users/{usuario_id}/role": {
      "patch": {
        "tags": [
          "admin"
        ],
        "summary": "Alterar Papel Usuario",
        "description": "Só admin: promove ou rebaixa o papel de qualquer usuário. Essa é a\nação exclusiva de admin de verdade — recusa com 403 quem não for\nadmin, mesmo chamando o endpoint direto (dependência require_admin).",
        "operationId": "alterar_papel_usuario_auth_admin_users__usuario_id__role_patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "usuario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Usuario Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleUpdateIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioOut"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, inválido ou expirado",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Credenciais inválidas ou expiradas"
                }
              }
            }
          },
          "403": {
            "description": "Autenticado, mas sem papel admin",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Acesso restrito a admins"
                }
              }
            }
          },
          "400": {
            "description": "`role` enviado não é um dos papéis válidos",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Papel inválido. Use um de: professor, professor_pro, coordenador, admin"
                }
              }
            }
          },
          "404": {
            "description": "usuario_id não existe",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Usuário não encontrado"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/users/{usuario_id}/role": {
      "put": {
        "tags": [
          "internal"
        ],
        "summary": "Definir Papel Pago",
        "description": "Plano pago (atividade 7): o webhook do Stripe chega no catálogo, que\nconfirma a assinatura e pede aqui a troca do papel — quem é dono da\ntabela `usuarios` continua sendo só o auth-service.\n\nAdmin nunca é rebaixado por plano (nem por cancelamento): o papel dele\nnão veio de pagamento.",
        "operationId": "definir_papel_pago_internal_users__usuario_id__role_put",
        "parameters": [
          {
            "name": "usuario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Usuario Id"
            }
          },
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PapelPagoIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ForgotPasswordIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ForgotPasswordIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "senha": {
            "type": "string",
            "title": "Senha"
          }
        },
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "title": "LoginIn"
      },
      "PapelPagoIn": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "role"
        ],
        "title": "PapelPagoIn"
      },
      "RegisterIn": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Nome"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "senha": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "title": "Senha"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "title": "RegisterIn"
      },
      "ResetPasswordIn": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "nova_senha": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "title": "Nova Senha"
          }
        },
        "type": "object",
        "required": [
          "token",
          "nova_senha"
        ],
        "title": "ResetPasswordIn"
      },
      "RoleUpdateIn": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "role"
        ],
        "title": "RoleUpdateIn"
      },
      "TokenOut": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "TokenOut"
      },
      "UsuarioOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "criado_em": {
            "type": "string",
            "format": "date-time",
            "title": "Criado Em"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nome",
          "email",
          "role",
          "criado_em"
        ],
        "title": "UsuarioOut"
      },
      "UsuarioPublicoOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nome"
        ],
        "title": "UsuarioPublicoOut",
        "description": "Só o que pode aparecer num perfil público (atividade 6) — sem\ne-mail nem papel."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
